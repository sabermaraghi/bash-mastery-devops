# Copy to .env and fill in.  .env is gitignored — never commit real secrets.
APP_ENV=staging            # one of: dev | staging | prod
TARGET_HOST=api.example.com
TARGET_PORT=443
API_KEY=sk-replace-me
DB_PASS=replace-me
SSH_KEY=replace-me

# optional (have safe defaults)
DEBUG=false
LOG_LEVEL=warn
MAX_RETRIES=5
